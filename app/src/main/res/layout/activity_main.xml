<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Live camera feed (unchanged) -->
    <android.opengl.GLSurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_panel_top"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Tip pill (sits just below the title bar) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_tip_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_instruction2"
            android:textColor="@color/ink"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- Scanning frame with four corner brackets -->
    <FrameLayout
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="top|start"
            android:rotation="0"
            android:src="@drawable/ic_scan_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="top|end"
            android:rotation="90"
            android:src="@drawable/ic_scan_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom|end"
            android:rotation="180"
            android:src="@drawable/ic_scan_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom|start"
            android:rotation="270"
            android:src="@drawable/ic_scan_corner"
            android:contentDescription="@null" />

    </FrameLayout>

    <!-- Bottom panel with the scan button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_panel_bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="26dp">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/coral"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:stateListAnimator="@null"
            android:text="@string/start_scan"
            android:textColor="@color/surface"
            android:textSize="18sp"
            android:textStyle="bold" />
        <!--android:background="@drawable/bg_button_primary"-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/scan_instruction4"
            android:textColor="@color/muted"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>